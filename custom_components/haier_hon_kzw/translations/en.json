{
  "config": {
    "flow_title": "{host}",
    "step": {
      "user": {
        "title": "Add a Haier / Thermor heat pump",
        "description": "The original Wi-Fi key (KZW-W002) must be connected to the network. Its MAC address is listed in your router's device list.",
        "data": {
          "name": "Name (room)",
          "host": "Wi-Fi key IP address",
          "mac": "Wi-Fi key MAC address"
        },
        "data_description": {
          "name": "The name shown in Home Assistant, usually the room it is in.",
          "mac": "12 characters, with or without \":\"."
        }
      },
      "discovery_confirm": {
        "title": "Heat pump discovered",
        "description": "A Haier Wi-Fi key was found at {host} (MAC {mac}). Give this heat pump a name (the room).",
        "data": {
          "name": "Name (room)"
        }
      },
      "reconfigure": {
        "title": "Change the IP address",
        "data": {
          "host": "Wi-Fi key IP address"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot reach the key on port 56800. Check the IP address.",
      "not_hon": "The key answers but not with the hOn protocol: this unit is not supported.",
      "invalid_mac": "Invalid MAC address (12 hexadecimal characters expected)."
    },
    "abort": {
      "already_configured": "This heat pump is already configured.",
      "not_hon": "This Haier device is not a supported heat pump.",
      "reconfigure_successful": "IP address updated."
    }
  },
