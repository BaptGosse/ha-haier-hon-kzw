        "hvac_mode": {
          "name": "Mode",
          "description": "Off, heat, cool, auto, dry or fan only."
        },
        "temperature": {
          "name": "Target temperature",
          "description": "In °C."
        },
        "fan_mode": {
          "name": "Fan",
          "description": "Quiet, auto, low, medium, high or turbo (quiet and turbo are not available in fan only mode)."
        },
        "preset_mode": {
          "name": "Preset",
          "description": "Sleep, or frost protection 10 °C (heat mode only)."
        },
        "vertical_position": {
          "name": "Vertical position",
          "description": "A fixed position, or swing."
        },
        "horizontal_position": {
          "name": "Horizontal position",
          "description": "A fixed position, or swing."
        },
        "display": {
          "name": "Display",
          "description": "Turns the indoor unit display on or off."
        },
